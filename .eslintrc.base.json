{
  "root": true,
  "ignorePatterns": ["**/*"],
  "plugins": ["@nx"],
  "overrides": [
    {
      "files": ["{package,project}.json"],
      "parser": "jsonc-eslint-parser",
      "rules": {
        "@nx/dependency-checks": [
          "error",
          {
            "buildTargets": ["build"],
            "checkMissingDependencies": true,
            "checkObsoleteDependencies": true,
            "checkVersionMismatches": true,
            "ignoredDependencies": [
              "vue",
              "@nx/vite",
              "@vitejs/plugin-vue",
              "rollup-plugin-copy",
              "vite",
              "vite-plugin-dts",
              "js-yaml"
            ]
          }
        ]
      }
    },
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx", "*.vue"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": true,
            "allow": [],
            "depConstraints": [
              {
                "sourceTag": "core",
                "onlyDependOnLibsWithTags": [
                  "core",
                  "share",
                  "store",
                  "js",
                  "dataset",
                  "draw",
                  "ui",
                  "draggable"
                ]
              },
              {
                "sourceTag": "vue",
                "notDependOnLibsWithTags": ["react"]
              },
              {
                "sourceTag": "vue",
                "onlyDependOnLibsWithTags": [
                  "map",
                  "share",
                  "store",
                  "draggable",
                  "ui",
                  "vue",
                  "demo",
                  "core",
                  "js",
                  "dataset",
                  "draw",
                  "devtools"
                ]
              },
              {
                "sourceTag": "react",
                "notDependOnLibsWithTags": ["vue"]
              },
              {
                "sourceTag": "react",
                "onlyDependOnLibsWithTags": [
                  "map",
                  "share",
                  "store",
                  "draggable",
                  "ui",
                  "react",
                  "demo",
                  "core",
                  "js",
                  "dataset",
                  "draw",
                  "devtools"
                ]
              },
              {
                "sourceTag": "demo",
                "onlyDependOnLibsWithTags": [
                  "map",
                  "share",
                  "store",
                  "draggable",
                  "ui",
                  "vue",
                  "react",
                  "demo",
                  "core",
                  "js",
                  "dataset",
                  "draw",
                  "devtools"
                ]
              },
              {
                "sourceTag": "share",
                "onlyDependOnLibsWithTags": ["share", "store", "js"]
              },
              {
                "sourceTag": "draggable",
                "onlyDependOnLibsWithTags": [
                  "draggable",
                  "share",
                  "store",
                  "core",
                  "js",
                  "ui"
                ]
              },
              {
                "sourceTag": "map",
                "onlyDependOnLibsWithTags": [
                  "map",
                  "share",
                  "store",
                  "draggable",
                  "ui",
                  "vue",
                  "react",
                  "core",
                  "js",
                  "dataset",
                  "draw",
                  "devtools",
                  "demo"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.ts", "*.tsx"],
      "extends": ["plugin:@nx/typescript"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "extends": ["plugin:@nx/javascript"],
      "rules": {}
    },
    {
      "files": ["*.spec.ts", "*.spec.tsx", "*.spec.js", "*.spec.jsx"],
      "env": {
        "jest": true
      },
      "rules": {}
    }
  ]
}
