{
  "name": "vue-library-map",
  "version": "0.0.1",
  "author": {
    "name": "hung.pv"
  },
  "bugs": "https://github.com/hung4564/vue-library/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hung4564/vue-library"
  },
  "scripts": {
    "ts-check": "nx run-many --target ts-check --all",
    "lint": "nx run-many --target lint --all",
    "build": "nx run-many --target lint,build --all",
    "release-publish": "nx run-many --target nx-release-publish --all",
    "docs:pre-link": "node scripts/link-docs.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "draggable:build": "nx run-many --projects=tag:draggable --exclude=tag:demo --target=lint,build",
    "draggable:version": "nx release version --group=draggable",
    "draggable:release": "nx release --group=draggable",
    "draggable:release:local": "nx release version --group=draggable --git-commit=false --git-tag=false && nx release publish --group=draggable --registry=http://localhost:4873",
    "draggable:dev-vue": "nx serve demo-draggable",
    "draggable:dev-react": "nx serve react-demo-draggable",
    "draggable:site:dev": "node scripts/vitepress-demo-draggable.js dev",
    "draggable:site:build": "node scripts/build-demo-draggable-site.js",
    "draggable:site:preview": "npx serve deploy/demo-draggable -l 5173",
    "map:dev-vue": "nx serve vue-demo-map",
    "map:dev-react": "nx serve react-demo-map",
    "map:lint": "nx run-many --projects=tag:map --exclude=tag:demo --target=lint,typecheck,ts-check",
    "map:build": "nx run-many --projects=tag:map --exclude=tag:demo --target=lint,build",
    "map:version": "nx release version --group=map",
    "map:release": "nx release --group=map",
    "map:release:local": "nx release version --group=map --git-commit=false --git-tag=false && nx release publish --group=map --registry=http://localhost:4873",
    "map:site:dev": "node scripts/link-docs.js && node scripts/vitepress-demo-map.js dev",
    "map:site:build": "node scripts/build-demo-map-site.js",
    "map:site:preview": "npx serve deploy/demo-map -l 5173",
    "map-docs:build": "npm run map:site:build",
    "share:build": "nx run-many --projects=tag:share --target=lint,build",
    "share:release": "nx run-many --projects=tag:share --target=lint,build,nx-release-publish",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "commit": "git-cz"
  },
  "private": true,
  "dependencies": {
