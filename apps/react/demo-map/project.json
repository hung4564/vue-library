{
  "name": "react-demo-map",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/react/demo-map/src",
  "projectType": "application",
  "tags": ["map", "react", "demo"],
  "// targets": "to see all targets run: nx show project react-demo-map --web",
