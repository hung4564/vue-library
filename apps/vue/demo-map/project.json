{
  "name": "vue-demo-map",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/vue/demo-map/src",
  "tags": ["map", "vue", "demo"],
  "// targets": "to see all targets run: nx show project vue-demo-map --web",
  "targets": {
    "publish-demo": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "vite build --outDir=../../../deploy/demo-map/vue --emptyOutDir"
        ],
        "cwd": "{projectRoot}"
      }
    }
  }
}
