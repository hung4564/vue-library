{
  "name": "vue-demo-map",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/vue/demo-map/src",
  "// targets": "to see all targets run: nx show project vue-demo-map --web",
  "targets": {
    "publish-demo": {
      "cache": true,
      "inputs": ["production", "^production"],
      "executor": "nx:run-commands",
      "options": {
        "commands": ["vite build"],
        "outDir": "../../../deploy/demo-map",
        "cwd": "{projectRoot}"
      }
    }
  }
}
