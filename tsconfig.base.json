{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@hungpvq/demo-map-datasets": ["libs/demo/map-datasets/src/index.ts"],
      "@hungpvq/draggable": ["libs/draggable/core/src/index.ts"],
      "@hungpvq/map-core": ["libs/map-core/core/src/index.ts"],
      "@hungpvq/map-dataset": ["libs/map-core/map-dataset/src/index.ts"],
      "@hungpvq/react-draggable": ["libs/react/draggable/src/index.ts"],
      "@hungpvq/react-map-core": ["libs/react/map-core/src/index.ts"],
      "@hungpvq/react-map-dataset": ["libs/react/map-dataset/src/index.ts"],
      "@hungpvq/router": ["libs/router/src/index.ts"],
      "@hungpvq/shared": ["libs/share/shared/src/index.ts"],
      "@hungpvq/shared-core": ["libs/share/core/src/index.ts"],
      "@hungpvq/shared-file": ["libs/share/file/src/index.ts"],
      "@hungpvq/shared-log": ["libs/share/log/src/index.ts"],
      "@hungpvq/shared-store": ["libs/share/store/src/index.ts"],
      "@hungpvq/ui-core": ["libs/ui/core/src/index.ts"],
      "@hungpvq/vue-content-menu": ["libs/vue/content-menu/src/index.ts"],
      "@hungpvq/vue-draggable": ["libs/vue/draggable/src/index.ts"],
      "@hungpvq/vue-map-core": ["libs/vue/map-core/src/index.ts"],
      "@hungpvq/vue-map-dataset": ["libs/vue/map-dataset/src/index.ts"],
      "@hungpvq/vue-map-devtools": ["libs/vue/map-devtools/src/index.ts"],
      "@hungpvq/vue-map-draw": ["libs/vue/map-draw/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
