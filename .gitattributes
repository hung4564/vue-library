# Normalize text files to LF in the repo and on checkout (Windows + CI).
# Keeps Prettier endOfLine=lf and Git in sync; avoids format ↔ git add loops.
* text=auto eol=lf

# Windows shell scripts keep CRLF
*.{cmd,bat,ps1} text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.7z binary
*.pdf binary
*.mp4 binary
*.webm binary
