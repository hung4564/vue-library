{
  "name": "@hungpvq/react-map-draw",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/react/map-draw/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["map", "react", "draw"],
  "targets": {
    "ts-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsc -p tsconfig.lib.json --noEmit"],
        "forwardAllArgs": false
      }
    },
    "nx-release-publish": {
      "options": { "packageRoot": "dist/{projectRoot}" }
    }
  }
}
