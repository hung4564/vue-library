    "@hungpvq/shared-log": "~0.0.1",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.2.0",
    "maplibre-gl": "^5.4.0",
    "mitt": "^3.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@uiw/react-color-sketch": "^2.10.3",
    "file-saver": "^2.0.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
