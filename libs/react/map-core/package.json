  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hung4564/vue-library"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "sideEffects": [
