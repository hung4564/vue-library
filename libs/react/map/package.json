{
  "name": "@hungpvq/react-map",
  "version": "1.2.0",
  "description": "Batteries-included React map stack: map-core + dataset + draggable shell + installMapApp",
  "author": {
    "name": "hung.pv"
  },
  "bugs": "https://github.com/hung4564/vue-library/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hung4564/vue-library"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./style.css": {
      "default": "./style.css"
    }
  },
  "dependencies": {
    "@hungpvq/draggable": "^1.4.0",
    "@hungpvq/map-core": "^1.2.0",
    "@hungpvq/map-dataset": "^1.2.0",
    "@hungpvq/react-draggable": "^1.4.0",
    "@hungpvq/react-map-core": "^1.2.0",
    "@hungpvq/react-map-dataset": "^1.2.0",
    "@hungpvq/shared": "^0.4.0",
    "@hungpvq/shared-log": "^0.1.0",
    "@hungpvq/shared-store": "^0.3.1",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.2.0",
    "react-rnd": "^10.5.2",
    "sortablejs": "^1.15.2"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.4.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
