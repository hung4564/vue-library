{
  "name": "@hungpvq/shared-log",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "dependencies": {
    "@hungpvq/shared-store": "^0.3.1",
    "tslib": "^2.3.0"
  },
  "author": {
    "name": "hung.pv"
  },
  "bugs": "https://github.com/hung4564/vue-library/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hung4564/vue-library"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react/index.d.ts",
      "import": "./src/react/index.js",
      "require": "./src/react/index.js",
      "default": "./src/react/index.js"
    },
    "./vue": {
      "types": "./src/vue/index.d.ts",
      "import": "./src/vue/index.js",
      "require": "./src/vue/index.js",
      "default": "./src/vue/index.js"
    },
    "./style.css": {
      "default": "./src/style.css"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.13"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
