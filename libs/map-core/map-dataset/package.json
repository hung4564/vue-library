{
  "name": "@hungpvq/map-dataset",
  "version": "1.0.1",
  "author": {
    "name": "hung.pv"
  },
  "bugs": "https://github.com/hung4564/vue-library/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hung4564/vue-library"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json",
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.js"
    },
    "./geojson": {
      "types": "./geojson.d.ts",
      "import": "./geojson.js"
    },
    "./raster": {
      "types": "./raster.d.ts",
      "import": "./raster.js"
    },
    "./vector-tile": {
      "types": "./vector-tile.d.ts",
      "import": "./vector-tile.js"
    },
    "./identify": {
      "types": "./identify.d.ts",
      "import": "./identify.js"
    },
    "./menu": {
      "types": "./menu.d.ts",
      "import": "./menu.js"
    },
    "./style": {
      "types": "./style.d.ts",
      "import": "./style.js"
    },
    "./create-control": {
      "types": "./create-control.d.ts",
      "import": "./create-control.js"
    },
    "./geo-export": {
      "types": "./geo-export.d.ts",
      "import": "./geo-export.js"
    },
    "./data-management": {
      "types": "./data-management.d.ts",
      "import": "./data-management.js"
    },
    "./attribute-table": {
      "types": "./attribute-table.d.ts",
      "import": "./attribute-table.js"
    },
    "./assets/*": "./assets/*",
    "./style.css": {
      "default": "./style.css"
    }
  },
  "dependencies": {
    "@hungpvq/map-core": "~1.0.1",
    "@turf/boolean-intersects": "^6.5.0",
    "@turf/helpers": "^6.5.0",
    "mitt": "^3.0.1",
    "@hungpvq/shared": ">=0.0.1",
    "@hungpvq/shared-log": ">=0.0.1",
    "@mdi/js": "^7.4.47"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.4.0",
    "@tmcw/togeojson": "^7.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "jszip": "^3.10.1",
    "papaparse": "^5.5.2",
    "shpjs": "^6.2.0",
    "topojson-client": "^3.1.0",
    "tokml": "^0.4.0",
    "@mapbox/shp-write": "^0.4.3",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@tmcw/togeojson": {
      "optional": true
    },
    "@xmldom/xmldom": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "papaparse": {
      "optional": true
    },
    "shpjs": {
      "optional": true
    },
    "topojson-client": {
      "optional": true
    },
    "tokml": {
      "optional": true
    },
    "@mapbox/shp-write": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
