{
  "name": "@hungpvq/map-core",
  "version": "1.0.1",
  "author": {
    "name": "hung.pv"
  },
  "bugs": "https://github.com/hung4564/vue-library/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hung4564/vue-library"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./style.css": {
      "default": "./style.css"
    },
    "./worker": {
      "types": "./worker.d.ts",
      "import": "./worker.js"
    },
    "./basemap": {
      "types": "./basemap.d.ts",
      "import": "./basemap.js"
    },
    "./crs": {
      "types": "./crs.d.ts",
      "import": "./crs.js"
    },
    "./event": {
      "types": "./event.d.ts",
      "import": "./event.js"
    },
    "./image": {
      "types": "./image.d.ts",
      "import": "./image.js"
    },
    "./legend": {
      "types": "./legend.d.ts",
      "import": "./legend.js"
    },
    "./measurement": {
      "types": "./measurement.d.ts",
      "import": "./measurement.js"
    },
    "./menu": {
      "types": "./menu.d.ts",
      "import": "./menu.js"
    },
    "./print": {
      "types": "./print.d.ts",
      "import": "./print.js"
    },
    "./theme": {
      "types": "./theme.d.ts",
      "import": "./theme.js"
    },
    "./toolbar": {
      "types": "./toolbar.d.ts",
      "import": "./toolbar.js"
    }
  },
  "dependencies": {
    "mitt": "^3.0.1"
  },
  "peerDependencies": {
    "@mdi/js": "^7.4.47",
    "proj4": "^2.11.0",
    "maplibre-gl": "^5.4.0",
    "@hungpvq/shared-log": ">=0.0.1",
    "@turf/turf": "^6.5.0",
    "@maplibre/maplibre-gl-style-spec": "^23.2.1",
    "file-saver": "^2.0.5"
  }
}
